# Streamplify DECK (0100:1000)
# hidraw node: images, brightness, button events
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0100", ATTRS{idProduct}=="1000", MODE="0660", TAG+="uaccess", GROUP="plugdev"
# USB device node: lets the client USB-reset a deck whose firmware got out of sync
SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="0100", ATTR{idProduct}=="1000", MODE="0660", TAG+="uaccess", GROUP="plugdev"
